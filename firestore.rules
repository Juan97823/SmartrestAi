
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    function isWaiter() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_waiter/$(request.auth.uid));
    }
    function isCashier() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_cashier/$(request.auth.uid));
    }
    function isKitchen() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_kitchen/$(request.auth.uid));
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update: if isAdmin() || request.auth.uid == userId;
    }

    match /roles_admin/{userId} { allow read, write: if isAdmin(); }
    match /roles_waiter/{userId} { allow read, write: if isAdmin(); }
    match /roles_kitchen/{userId} { allow read, write: if isAdmin(); }

    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    match /ingredients/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isKitchen();
    }

    match /tables/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isWaiter();
    }
  }
}
